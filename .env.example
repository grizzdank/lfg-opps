# LFG Opportunity Finder Configuration

# ============================================
# Freelancer.com Credentials
# ============================================
# Get your OAuth token from: https://developers.freelancer.com/
FLN_OAUTH_TOKEN=your_freelancer_oauth_token
FLN_URL=https://www.freelancer.com
# Use sandbox for testing:
# FLN_URL=https://www.freelancer-sandbox.com

# Freelancer.com filters
# Hard cap: exclude projects with budgets above this amount.
# (Freelancer requires $99 verification to bid > $2500)
FLN_MAX_BUDGET=2500
# Optional: override global MIN_SCORE for Freelancer only
# FLN_MIN_SCORE=60

# ============================================
# Upwork Credentials (after API approval)
# ============================================
# Apply at: https://support.upwork.com/hc/en-us/articles/115015857647
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=

# Upwork filters (optional per-source overrides)
# UPWORK_MIN_BUDGET=2500
# UPWORK_MIN_SCORE=60

# ============================================
# Email Configuration (for digests)
# ============================================
# Gmail: use App Password (not regular password)
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=dave@lfgconsultants.com
EMAIL_FROM=LFG Opportunity Finder <notifications@lfgconsultants.com>

# ============================================
# Global Scoring & Filtering (fallback defaults)
# ============================================
MIN_BUDGET=2500
MIN_SCORE=60
MAX_RESULTS_PER_RUN=50

# Budget score weights
BUDGET_WEIGHT=0.4
CLIENT_WEIGHT=0.4
KEYWORD_WEIGHT=0.2

# ============================================
# Runtime Settings
# ============================================
# How often to check (in minutes)
CHECK_INTERVAL=60
# Database location
DB_PATH=data/opportunities.db
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# SAM.gov Federal Opportunities
# ============================================
# Get your free API key from: https://beta.sam.gov/ (Account -> API Keys)
SAM_GOV_API_KEY=your_api_key_here

# NAICS codes to search.
# If unset, defaults to consulting-related NAICS codes.
# (Use either SAM_NAICS_CODES or SAM_GOV_NAICS_CODES for back-compat.)
# SAM_NAICS_CODES=541611,541618,541519,541512,541690

# SAM.gov filters (defaults are intentionally permissive)
SAM_MIN_BUDGET=0
SAM_MIN_SCORE=0
# If true, only show SDVOSB set-asides
SAM_SDVO_ONLY=false
